{
  "name": "cron",
  "version": "1.0.0",
  "description": "生成Cron表达式，用于定时任务配置",
  "author": "system",
  "type": "builtin",
  "category": "general",
  "tags": ["Cron", "定时", "任务"],
  "icon": "calendar",
  "parameters": {
    "type": "object",
    "properties": {
      "frequency": {
        "type": "string",
        "enum": ["daily", "weekly", "monthly", "hourly", "every_minute", "custom"],
        "description": "执行频率类型"
      },
      "hour": {
        "type": "integer",
        "minimum": 0,
        "maximum": 23,
        "default": 0,
        "description": "小时（0-23）"
      },
      "minute": {
        "type": "integer",
        "minimum": 0,
        "maximum": 59,
        "default": 0,
        "description": "分钟（0-59）"
      },
      "day_of_month": {
        "type": "integer",
        "minimum": 1,
        "maximum": 31,
        "default": 1,
        "description": "每月的第几天（1-31），custom 模式不传时表示每天"
      },
      "day_of_week": {
        "type": "string",
        "enum": ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"],
        "description": "星期几，生成表达式时会转换为 1-6/0（周一至周日）"
      },
      "expression": {
        "type": "string",
        "description": "自定义 5 段 Cron 表达式（仅 custom 模式），如 */5 * * * *；提供后忽略 hour/minute/day_of_month/day_of_week"
      }
    },
    "required": ["frequency"],
    "additionalProperties": false
  },
  "handler": "handler.js",
  "examples": [
    {
      "input": "frequency: daily, hour: 8, minute: 0",
      "output": "生成每天8:00执行的Cron表达式：0 8 * * *"
    }
  ]
}
