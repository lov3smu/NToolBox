{
  "name": "db-connect",
  "version": "1.2.0",
  "description": "管理数据库连接：列出可用连接、测试、连接、断开、查看状态。用户提到连接数据库或指定连接名时使用。",
  "author": "system",
  "type": "builtin",
  "category": "database",
  "tags": ["数据库", "连接", "MySQL", "连接管理"],
  "icon": "database",
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": ["list", "test", "connect", "disconnect", "status"],
        "description": "list 列出连接；connect 连接；disconnect 断开；test 测试；status 查看状态"
      },
      "connection_name": {
        "type": "string",
        "description": "连接名称，如 mysql57；未指定时先调用 list 并询问用户"
      }
    },
    "required": ["action"],
    "additionalProperties": false
  },
  "handler": "handler.js",
  "examples": [
    {
      "input": "连接到mysql57数据库",
      "output": "db-connect({action: 'connect', connection_name: 'mysql57'})"
    },
    {
      "input": "查看有哪些数据库连接",
      "output": "db-connect({action: 'list'})"
    }
  ]
}
