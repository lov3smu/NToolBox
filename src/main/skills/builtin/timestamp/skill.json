{
  "name": "timestamp",
  "version": "1.0.0",
  "description": "Unix时间戳与日期时间互转，支持秒和毫秒，并可按指定时区展示",
  "author": "system",
  "type": "builtin",
  "category": "general",
  "tags": ["时间", "时间戳", "转换"],
  "icon": "clock",
  "parameters": {
    "type": "object",
    "properties": {
      "timestamp": {
        "type": "integer",
        "description": "Unix时间戳：10 位按秒、13 位按毫秒解析，其他按数值大小推断"
      },
      "date_string": {
        "type": "string",
        "description": "日期字符串，格式如 2024-01-01 或 2024-01-01 12:00:00，按本地时区解析"
      },
      "timezone": {
        "type": "string",
        "description": "输出时区，IANA 名称，如 Asia/Shanghai；默认使用系统时区"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "handler": "handler.js",
  "examples": [
    {
      "input": "timestamp: 1704067200",
      "output": "转换成日期时间和ISO格式"
    },
    {
      "input": "date_string: 2024-01-01 00:00:00",
      "output": "转换成时间戳（秒和毫秒）"
    }
  ]
}
